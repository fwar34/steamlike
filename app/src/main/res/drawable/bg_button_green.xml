<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!-- 主操作按钮（绿色，如启动/保存） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">  <!-- 语法：selector 状态列表 drawable，根据状态选择不同子项 -->
    <item android:state_pressed="true">  <!-- 语法：item 状态项；按下状态 -->
        <shape>  <!-- 语法：shape 形状 drawable -->
            <solid android:color="#FF388E3C" />  <!-- 语法：solid 填充色；绿色（按下时较亮） -->
            <corners android:radius="10dp" />  <!-- 语法：corners 圆角 10dp -->
        </shape>  <!-- 结束 shape -->
    </item>  <!-- 结束按下态 item -->
    <item>  <!-- 语法：默认状态 item -->
        <shape>  <!-- 语法：shape 形状 -->
            <solid android:color="#FF2E7D32" />  <!-- 填充色：深绿色（默认态） -->
            <corners android:radius="10dp" />  <!-- 圆角 10dp -->
        </shape>  <!-- 结束 shape -->
    </item>  <!-- 结束默认态 item -->
</selector>  <!-- 结束 selector -->
