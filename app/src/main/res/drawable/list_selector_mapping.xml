<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!--
  按键映射列表行点击态
  默认 ListView 的 pressed 高亮是 Android 经典橙黄色，与深色界面不搭。
  这里改为半透明白色按压反馈：按压时有轻微高亮，其余状态透明。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">  <!-- 语法：selector 状态列表 drawable，根据列表项状态选择不同子项 -->
    <item android:state_pressed="true">  <!-- 语法：item 状态项；state_pressed=true 列表项被按下时 -->
        <shape>  <!-- 语法：shape 形状 drawable -->
            <solid android:color="#33FFFFFF" />  <!-- 语法：solid 填充色；#33 为 20% 不透明度白色（按压轻微高亮） -->
        </shape>  <!-- 结束 shape -->
    </item>  <!-- 结束按下态 item -->
    <item android:state_activated="true">  <!-- 语法：item 状态项；state_activated=true 列表项处于激活态（如当前选中行） -->
        <shape>  <!-- 语法：shape 形状 -->
            <solid android:color="#22FFFFFF" />  <!-- 填充色：#22 为 13% 不透明度白色（激活态微弱高亮） -->
        </shape>  <!-- 结束 shape -->
    </item>  <!-- 结束激活态 item -->
    <item>  <!-- 语法：默认状态 item（兜底） -->
        <shape>  <!-- 语法：shape 形状 -->
            <solid android:color="#00000000" />  <!-- 填充色：全透明（默认无高亮） -->
        </shape>  <!-- 结束 shape -->
    </item>  <!-- 结束默认态 item -->
</selector>  <!-- 结束 selector -->
