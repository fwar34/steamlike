<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!-- 圆角输入框背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">  <!-- 语法：shape 形状 drawable 根节点 -->
    <solid android:color="#33222222" />  <!-- 语法：solid 填充色；#33 为 20% 不透明度，黑色（半透明底） -->
    <!-- 语法：stroke 描边（边框）：android:width=1dp 描边宽度；android:color=#55FFFFFF 描边颜色（#55 为 33% 不透明度白色） -->
    <stroke
        android:width="1dp"
        android:color="#55FFFFFF" />
    <corners android:radius="10dp" />  <!-- 语法：corners 圆角；radius 圆角半径 10dp -->
</shape>  <!-- 结束 shape -->
