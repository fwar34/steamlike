<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!-- Adaptive icon 背景：深色渐变（全出血，由系统遮罩裁成圆形/圆角方形） -->
<!-- 语法：shape 形状 drawable 根节点
     android:shape=rectangle：指定形状类型为矩形 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 语法：gradient 渐变：android:angle=45 渐变方向角度（左下到右上）；android:endColor=#181A24 渐变结束颜色（深蓝黑）；android:startColor=#2E3140 渐变起始颜色（深蓝灰）；android:type=linear 线性渐变 -->
    <gradient
        android:angle="45"
        android:endColor="#181A24"
        android:startColor="#2E3140"
        android:type="linear" />
</shape>  <!-- 结束 shape -->
