<?xml version="1.0" encoding="utf-8"?>
<!--
  操作层设置 Activity 布局（深色美化版）

  布局结构（垂直 LinearLayout）:
  1. 标题文字
  2. 操作层选择行（标签 + Spinner）
  3. 层信息行（编辑名称按钮 + 编辑触发按键按钮）
  4. 按键映射标题
  5. 按键映射列表（ListView，占满剩余空间）
  6. 底部保存按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="16dp">

    <!-- ===== 标题 ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="操作层设置"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:paddingBottom="12dp" />

    <!-- ===== 操作层选择行 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择操作层: "
            android:textSize="16sp"
            android:textColor="#FFDDDDDD" />

        <!-- 操作层下拉选择器，包含 Common + Layer1-Layer10 -->
        <Spinner
            android:id="@+id/spinner_layer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:textColor="#FFFFFFFF"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- ===== 层信息行（名称 + 触发按键） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <!-- 编辑当前操作层名称 -->
        <Button
            android:id="@+id/btn_edit_layer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="层名称"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_button" />

        <!-- 编辑当前操作层触发按键（Common 层禁用） -->
        <Button
            android:id="@+id/btn_edit_trigger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="触发按键"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_button" />
    </LinearLayout>

    <!-- ===== 按键映射列表标题 ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="按键映射（点击编辑）:"
        android:textSize="16sp"
        android:textColor="#FFDDDDDD"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!--
      按键映射列表
      显示当前操作层中所有手柄按键的映射情况。
      layout_weight=1 让列表占据剩余的所有垂直空间。
    -->
    <ListView
        android:id="@+id/list_mappings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:divider="#33FFFFFF"
        android:dividerHeight="1dp"
        android:padding="6dp" />

    <!-- ===== 底部保存按钮 ===== -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存配置"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/bg_button_green"
        android:layout_marginTop="10dp" />

</LinearLayout>
